# Stage 1: Reference the Web3Signer image as a named build stage. We do not RUN
# anything inside it — `COPY --from=sql-source` pulls the migration files straight
# out of the image layers — so this Dockerfile works even when the Web3Signer
# image has no shell (e.g. the distroless variant).
ARG WEB3SIGNER_IMAGE=consensys/web3signer:develop
FROM ${WEB3SIGNER_IMAGE} AS sql-source

# Stage 2: Minimal copier image containing only the Web3Signer SQL migration files.
FROM alpine:3.18
COPY --from=sql-source /opt/web3signer/migrations/postgresql/ /sql-source/

# Validate files were copied during build
RUN [ "$(ls -A /sql-source)" ] || (echo "Error: No SQL files found in build!" >&2 && exit 1)

ENTRYPOINT ["sh", "-c"]
CMD ["echo 'Updating SQL files...'; rm -f /flyway/sql/*.sql; cp -v /sql-source/*.sql /flyway/sql/; echo 'Success! Copied:'; ls /flyway/sql/; exit 0"]
